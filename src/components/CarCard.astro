---
// A /cars grid card. The photo opens the quick look (a plain link to the car
// if scripts are off, or on ctrl/middle click); the title opens the car.
import type { Car } from "../lib/cars.ts";
import { specsLine, priceLabel } from "../lib/cars.ts";
import CarPhoto from "./CarPhoto.astro";

interface Props {
  car: Car;
  fit: "contain" | "cover";
  /** Load now rather than when scrolled near (the first row). */
  eager?: boolean;
  /** The page's main image (the first card): fetched before anything else. */
  priority?: boolean;
}
const { car, fit, eager = false, priority = false } = Astro.props;
const href = `/cars/${car.slug}`;
const first = car.photos[0];
---

<article class="card">
  <a class="frame" href={href} data-quick={car.slug} aria-label={`Quick look: ${car.make} ${car.model}`}>
    {first ? (
      <CarPhoto
        photo={first}
        fit={fit}
        eager={eager}
        priority={priority}
        sizes="(min-width: 1240px) 296px, (min-width: 900px) calc((100vw - 80px) / 3), (min-width: 600px) calc((100vw - 48px) / 2), calc(100vw - 32px)"
        style={`view-transition-name: car-${car.id}`}
      />
    ) : (
      <span class="none">Photos coming soon</span>
    )}
    {car.photos.length > 1 && <span class="count">{car.photos.length} photos</span>}
    {car.status !== "available" && <span class="status">{car.status === "sold" ? "Sold" : "Reserved"}</span>}
  </a>
  <div class="info">
    <div class="eyebrow">{car.make}</div>
    <h2 class="model"><a href={href}>{car.model}</a></h2>
    <p class="specs">{specsLine(car)}</p>
    <p class="price">{priceLabel(car)}</p>
  </div>
</article>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
  }
  .frame {
    position: relative;
    display: block;
    aspect-ratio: var(--card-ratio);
    background: var(--color-line);
    overflow: hidden;
    cursor: zoom-in;
  }
  .none {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--color-muted);
    font-size: 14px;
  }
  .count,
  .status {
    position: absolute;
    bottom: 8px;
    background: rgb(10 16 26 / 0.72);
    color: #fff;
    font-size: 12px;
    padding: 2px 8px;
  }
  .count {
    right: 8px;
  }
  .status {
    left: 8px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .info {
    padding: 12px 14px 16px;
    display: grid;
    gap: 4px;
    align-content: start;
    min-width: 0;
  }
  .model {
    font: 600 21px/1.15 var(--font-display);
    margin: 4px 0 0;
    overflow-wrap: anywhere;
  }
  .model a {
    color: inherit;
    text-decoration: none;
  }
  .model a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .specs {
    font-size: 14px;
    color: var(--color-muted);
    margin: 0;
  }
  .price {
    font: 700 20px/1 var(--font-display);
    margin: 8px 0 0;
    font-variant-numeric: tabular-nums;
  }
</style>
