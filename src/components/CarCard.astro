---
// A /cars grid card. The photo opens the quick look (a plain link to the car
// if scripts are off, or on ctrl/middle click); the title opens the car.
// The photos swipe (src/scripts/card-photos.ts), as on v1.
// Only the first loads with the page; the others wait in a <template> until
// they're about to be reached.
import type { Car } from "../lib/cars.ts";
import { specsLine, priceLabel } from "../lib/cars.ts";
import CarPhoto from "./CarPhoto.astro";

interface Props {
  car: Car;
  fit: "contain" | "cover";
  /** Load now rather than when scrolled near (the first row). */
  eager?: boolean;
  /** The page's main image (the first card): fetched before anything else. */
  priority?: boolean;
}
const { car, fit, eager = false, priority = false } = Astro.props;
const href = `/cars/${car.slug}`;
const name = `${car.make} ${car.model}`;
const n = car.photos.length;
// How many swipe, as on v1: each adds to every list page's size, and the rest
// are a tap away.
const swipe = car.photos.slice(0, 3);
const sizes =
  "(min-width: 1240px) 296px, (min-width: 900px) calc((100vw - 80px) / 3), (min-width: 600px) calc((100vw - 48px) / 2), calc(100vw - 32px)";
---

<article class="card">
  <div class="photos" data-card-photos>
    <div class="track" style={n > 0 ? `view-transition-name: car-${car.id}` : undefined}>
      <a class="frame" href={href} data-quick={car.slug} aria-label={`Quick look: ${name}`}>
        {n === 0 && <span class="none">Photos coming soon</span>}
        {swipe.map((photo, i) => (
          <span class:list={["slide", { later: i > 0 }]}>
            {i === 0 ? (
              <CarPhoto photo={photo} fit={fit} eager={eager} priority={priority} sizes={sizes} />
            ) : (
              <template><CarPhoto photo={photo} fit={fit} eager sizes={sizes} /></template>
            )}
          </span>
        ))}
      </a>
    </div>
    {n > 1 && <span class="count">{n} photos</span>}
    {car.status !== "available" && <span class="status">{car.status === "sold" ? "Sold" : "Reserved"}</span>}
  </div>
  <div class="info">
    <div class="eyebrow">{car.make}</div>
    <h2 class="model"><a href={href}>{car.model}</a></h2>
    <p class="specs">{specsLine(car)}</p>
    <p class="price">{priceLabel(car)}</p>
  </div>
</article>

<script>
  import "../scripts/card-photos.ts";
</script>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
  }
  .photos {
    position: relative;
    aspect-ratio: var(--card-ratio);
    background: var(--color-line);
    overflow: hidden;
    min-width: 0;
  }
  /* The row of photos, swiped with the browser's own scrolling. The link in
     it takes the keyboard focus, and the arrow keys then move the row. */
  .track {
    height: 100%;
    overflow: auto hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .frame {
    display: flex;
    height: 100%;
    cursor: zoom-in;
  }
  /* The row would crop an outline drawn around the link. */
  .frame:focus-visible {
    outline: none;
  }
  .photos:has(.frame:focus-visible)::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 3px solid var(--color-accent);
    pointer-events: none;
  }
  .slide {
    display: block;
    flex: 0 0 100%;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  /* Without the script the later photos can't load, so there's one photo. */
  .later {
    display: none;
  }
  :global(html.js) .later {
    display: block;
  }
  .none {
    flex: 1;
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--color-muted);
    font-size: 14px;
  }
  .count,
  .status {
    position: absolute;
    bottom: 8px;
    background: rgb(10 16 26 / 0.72);
    color: #fff;
    font-size: 12px;
    padding: 2px 8px;
    pointer-events: none;
  }
  .count {
    right: 8px;
    font-variant-numeric: tabular-nums;
  }
  .status {
    left: 8px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .info {
    padding: 12px 14px 16px;
    display: grid;
    gap: 4px;
    align-content: start;
    min-width: 0;
  }
  .model {
    font: 600 21px/1.15 var(--font-display);
    margin: 4px 0 0;
    overflow-wrap: anywhere;
  }
  .model a {
    color: inherit;
    text-decoration: none;
  }
  .model a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .specs {
    font-size: 14px;
    color: var(--color-muted);
    margin: 0;
  }
  .price {
    font: 700 20px/1 var(--font-display);
    margin: 8px 0 0;
    font-variant-numeric: tabular-nums;
  }
</style>
